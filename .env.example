# ────────────────────────────────────────────────────────────────────────────
# VARIABLES DE ENTORNO — casa-norden-next
# Copiar este archivo como .env y completar los valores reales.
# NUNCA subir el .env al repositorio.
# ────────────────────────────────────────────────────────────────────────────

# URL del backend Payload CMS
# En desarrollo local: http://localhost:3001
# En producción: https://admin.casanorden.com.ar
NEXT_PUBLIC_PAYLOAD_URL=http://localhost:3001
PAYLOAD_URL=http://localhost:3001

# Token secreto compartido para revalidación On-Demand
REVALIDATION_TOKEN=norden_reval_secret_token_2026

# URL pública del sitio web
NEXT_PUBLIC_SITE_URL=https://casanorden.com.ar
